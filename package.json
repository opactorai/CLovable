{
  "name": "cc-lovable",
  "version": "1.0.0",
  "private": true,
  "description": "CC Lovable Development Environment",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run ensure:env && npm run ensure:venv && concurrently --raw \"npm run dev:api\" --prefix \"[WEB] \" \"npm run dev:web\"",
    "dev:api": "node scripts/run-api.js",
    "dev:web": "node scripts/run-web.js",
    "dev:electron": "cd apps/web && npm run electron:dev",
    "build": "cd apps/web && npm run build",
    "build:electron": "cd apps/web && npm run electron:build",
    "dist:electron": "cd apps/web && npm run electron:dist",
    "ensure:env": "node scripts/setup-env.js",
    "ensure:venv": "node scripts/setup-venv.js",
    "postinstall": "npm run ensure:env && npm run ensure:venv",
    "setup": "npm install",
    "clean": "node scripts/clean.js",
    "db:reset": "node scripts/reset-db.js",
    "db:backup": "node scripts/backup-db.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "react-icons": "^5.5.0"
  },
  "packageManager": "yarn@4.5.3+sha512.3003a14012e2987072d244c720506549c1aab73ee728208f1b2580a9fd67b92d61ba6b08fe93f6dce68fd771e3af1e59a0afa28dd242dd0940d73b95fedd4e90"
}
